# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=FinanceBtw
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=financebtw
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=financebtw_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://financebtw:change_me_in_production@localhost:5432/financebtw_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=financebtw_documents

# ─── JWT Auth ────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=generate_a_random_64_char_secret_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── LLM Providers ───────────────────────────────────────────────────────────
# Set at least one. Groq is recommended for development (free, no card).
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.3

# Active LLM provider: groq | gemini | openai | anthropic | deepseek | ollama
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# ─── Market Data Providers ───────────────────────────────────────────────────
# Yahoo Finance — no key needed
YAHOO_FINANCE_CACHE_TTL_SECONDS=300
YAHOO_FINANCE_REQUEST_DELAY_SECONDS=1.5

# NSE (nsepython) — no key needed
NSE_CACHE_TTL_SECONDS=300
NSE_REQUEST_DELAY_SECONDS=1.0
NSE_USE_SERVER_EDITION=false

# BSE (bsedata) — no key needed
BSE_CACHE_TTL_SECONDS=600

# TheNewsAPI — get free key at https://www.thenewsapi.com
THE_NEWS_API_KEY=
THE_NEWS_API_BASE_URL=https://api.thenewsapi.com/v1
THE_NEWS_API_CACHE_TTL_SECONDS=1800

# ─── US Market Plugin (future) ───────────────────────────────────────────────
FMP_API_KEY=
SEC_USER_AGENT_EMAIL=

# ─── Crypto Plugin (future) ──────────────────────────────────────────────────
COINGECKO_API_KEY=

# ─── Frontend (for reference) ────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
